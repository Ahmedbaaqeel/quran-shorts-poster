{"text": "[warm, heartfelt, calm] قَبْلَ أَنْ تَنَامَ… أَرْبَعُ سُنَنٍ تَحْفَظُ بَيْتَكَ.\nقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ:\nغَطُّوا الْإِنَاءَ، وَأَوْكُوا السِّقَاءَ، وَأَغْلِقُوا الْبَابَ، وَأَطْفِئُوا السِّرَاجَ،\nفَإِنَّ الشَّيْطَانَ لَا يَحُلُّ سِقَاءً، وَلَا يَفْتَحُ بَابًا، وَلَا يَكْشِفُ إِنَاءً.\n[softly] أَفْعَالٌ صَغِيرَةٌ… تُصْبِحُ حِصْنًا لِبَيْتِكَ.\n[warmly] فَأَحْيِهَا اللَّيْلَةَ… قَبْلَ أَنْ تَنَامَ.", "voice_id": "KXptrwcsEqqFSwRKJukF", "model": "eleven_v3", "alignment": {"characters": ["[", "w", "a", "r", "m", ",", " ", "h", "e", "a", "r", "t", "f", "e", "l", "t", ",", " ", "c", "a", "l", "m", "]", " ", "ق", "َ", "ب", "ْ", "ل", "َ", " ", "أ", "َ", "ن", "ْ", " ", "ت", "َ", "ن", "َ", "ا", "م", "َ", "…", " ", "أ", "َ", "ر", "ْ", "ب", "َ", "ع", "ُ", " ", "س", "ُ", "ن", "َ", "ن", "ٍ", " ", "ت", "َ", "ح", "ْ", "ف", "َ", "ظ", "ُ", " ", "ب", "َ", "ي", "ْ", "ت", "َ", "ك", "َ", ".", "\n", "ق", "َ", "ا", "ل", "َ", " ", "ر", "َ", "س", "ُ", "و", "ل", "ُ", " ", "ا", "ل", "ل", "َ", "ّ", "ه", "ِ", " ", "ص", "َ", "ل", "َ", "ّ", "ى", " ", "ا", "ل", "ل", "َ", "ّ", "ه", "ُ", " ", "ع", "َ", "ل", "َ", "ي", "ْ", "ه", "ِ", " ", "و", "َ", "س", "َ", "ل", "َ", "ّ", "م", "َ", ":", "\n", "غ", "َ", "ط", "ُ", "ّ", "و", "ا", " ", "ا", "ل", "ْ", "إ", "ِ", "ن", "َ", "ا", "ء", "َ", "،", " ", "و", "َ", "أ", "َ", "و", "ْ", "ك", "ُ", "و", "ا", " ", "ا", "ل", "س", "ِ", "ّ", "ق", "َ", "ا", "ء", "َ", "،", " ", "و", "َ", "أ", "َ", "غ", "ْ", "ل", "ِ", "ق", "ُ", "و", "ا", " ", "ا", "ل", "ْ", "ب", "َ", "ا", "ب", "َ", "،", " ", "و", "َ", "أ", "َ", "ط", "ْ", "ف", "ِ", "ئ", "ُ", "و", "ا", " ", "ا", "ل", "س", "ِ", "ّ", "ر", "َ", "ا", "ج", "َ", "،", "\n", "ف", "َ", "إ", "ِ", "ن", "َ", "ّ", " ", "ا", "ل", "ش", "َ", "ّ", "ي", "ْ", "ط", "َ", "ا", "ن", "َ", " ", "ل", "َ", "ا", " ", "ي", "َ", "ح", "ُ", "ل", "ُ", "ّ", " ", "س", "ِ", "ق", "َ", "ا", "ء", "ً", "،", " ", "و", "َ", "ل", "َ", "ا", " ", "ي", "َ", "ف", "ْ", "ت", "َ", "ح", "ُ", " ", "ب", "َ", "ا", "ب", "ً", "ا", "،", " 